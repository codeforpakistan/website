---
const normalizePath = (value: string) => {
  if (!value) return '/';
  const trimmed = value.replace(/\/+$/, '');
  return trimmed || '/';
};

const path = normalizePath(Astro.url.pathname);

const navHrefs = [
  '/about',
  '/about/history',
  '/about/people',
  '/programs',
  '/programs/fellowships',
  '/programs/internships',
  '/programs/innovator',
  '/programs/services',
  '/community',
  '/community/hackathons',
  '/community/labs',
  '/events',
  '/stories',
  '/projects',
  '/reports',
  '/volunteer',
  '/jobs',
  '/donate',
  '/contact',
  '/subscribe',
].map(normalizePath);

const activeHref = navHrefs
  .filter((href) => path === href || path.startsWith(`${href}/`))
  .sort((left, right) => right.length - left.length)[0];

const isActive = (href: string) => normalizePath(href) === activeHref;
---

