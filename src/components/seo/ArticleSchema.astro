---
interface Props {
  title: string;
  description?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  url: string;
}

const { title, description, image, datePublished, dateModified, url } = Astro.props;
const siteUrl = 'https://codeforpakistan.org';

const imagePath = image || '/img/cfp_logomark.png';
const resolvedImage = imagePath.startsWith('http') ? imagePath : `${siteUrl}${imagePath}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description || title,
  "image": resolvedImage,
  "url": url,
  "publisher": {
    "@type": "Organization",
    "name": "Code for Pakistan",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/img/cfp_logotype.svg`
    }
  },
  ...(datePublished && { "datePublished": datePublished }),
  ...(dateModified && { "dateModified": dateModified }),
  "author": {
    "@type": "Organization",
    "name": "Code for Pakistan"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
