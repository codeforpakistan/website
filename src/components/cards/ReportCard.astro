---
interface Props {
  href: string;
  image: string;
  title: string;
  summary?: string;
  year?: string;
}

const { href, image, title, summary = '', year = '' } = Astro.props;
---

<article class="bg-white rounded-lg border hover:border-gray-300 overflow-hidden">
  <a href={href} class="block">
    <img src={image} alt={title} class="w-full h-52 object-cover" loading="lazy" width="400" height="208" />
    <div class="p-4">
      <h3 class="font-semibold text-lg text-gray-900 line-clamp-2">{title}</h3>
      <p class="text-sm text-gray-600 mt-2 line-clamp-3">{summary}</p>
    </div>
  </a>
</article>
