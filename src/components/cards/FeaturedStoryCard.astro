---
interface Props {
  href: string;
  image: string;
  title: string;
  content: string;
  date?: string | Date;
  author?: string;
}

const { href, image, title, content, date, author = '' } = Astro.props;

// Extract plain text from content (remove markdown/HTML)
const plainText = content
  .replace(/!\[.*?\]\(.*?\)/g, '') // Remove images
  .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1') // Convert links to text
  .replace(/#+ /g, '') // Remove headings
  .replace(/[*_]{1,2}([^*_]+)[*_]{1,2}/g, '$1') // Remove bold/italic
  .replace(/\n+/g, ' ') // Replace newlines with spaces
  .trim();

// Get first ~250 characters
const excerpt = plainText.length > 250 
  ? plainText.substring(0, 250).trim() + '...' 
  : plainText;

const parsedDate = date ? new Date(date) : null;
const hasValidDate = parsedDate && !Number.isNaN(parsedDate.getTime());
const displayDate = hasValidDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(parsedDate)
  : date
    ? String(date)
    : null;
---

<a href={href} class="block bg-white rounded-lg border hover:border-gray-300 overflow-hidden">
  <div class="flex flex-col md:flex-row">
    <!-- Image - Left Half with 16:9 ratio -->
    <div class="md:w-1/2 aspect-video">
      <img src={image} alt={title} class="w-full h-full object-cover" loading="eager" width="800" height="450" />
    </div>
    
    <!-- Content - Right Half -->
    <div class="md:w-1/2 p-6 md:p-8 flex flex-col justify-center">
      <h3 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-3">{title}</h3>
      {author && (
        <p class="text-sm text-gray-600 mb-4">{author}</p>
      )}
      <p class="text-base text-gray-700 mb-4">{excerpt}</p>
      {displayDate && (
        <p class="text-sm text-gray-500">
          <time datetime={hasValidDate ? parsedDate.toISOString() : undefined}>{displayDate}</time>
        </p>
      )}
    </div>
  </div>
</a>
