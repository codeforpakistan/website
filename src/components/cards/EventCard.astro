---
interface Props {
  href: string;
  image: string;
  title: string;
  location?: string;
  summary?: string;
}

const { href, image, title, location = '', summary = '' } = Astro.props;
---

<a href={href} class="block bg-white rounded-lg border hover:border-gray-300 transition-shadow overflow-hidden">
  <img src={image} alt={title} class="w-full h-52 object-cover" />
  <div class="p-4">
    <h4 class="font-semibold text-gray-900 line-clamp-2">{title}</h4>
    <p class="text-sm text-gray-500 mt-1">{location}</p>
    <p class="text-sm text-gray-600 mt-2 line-clamp-2">{summary}</p>
  </div>
</a>
