---
// GetInvolved Component
interface Props {
  title?: string;
}

const { title = "Technology is changing the lives of millions of Pakistanis, and you can be a part of that change." } = Astro.props;
---

<section class="w-full bg-gradient-to-r from-cfp-green-500 to-cfp-green-600 p-4 lg:p-8 rounded-lg">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="flex-1">
      <h2 class="text-2xl md:text-3xl lg:text-3xl text-white leading-tight">
        {title}
      </h2>
    </div>
    <div class="flex-shrink-0">
      <a 
        href="/volunteer" 
        class="inline-block px-8 py-4 text-lg text-white bg-orange-500 hover:bg-orange-600 rounded-full transition-colors duration-200"
      >
        Get Involved
      </a>
    </div>
  </div>
</section>
