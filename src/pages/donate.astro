---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Donate">
  <div class="py-8">
  <div class="mb-6 space-y-2">
    <h1 class="text-3xl md:text-6xl tracking-tight">Donate</h1>
    <h2 class="text-lg md:text-3xl font-light text-gray-700">Support our mission to bridge the gap between government and citizens</h2>
  </div>
    <div class="flex flex-col md:flex-row gap-4 md:gap-8 lg:gap-12 xl:gap-16">
      <div class="flex-grow max-w-5xl">
        <section
  class="p-4 md:p-8 lg:p-16 text-white relative rounded-lg h-full bg-cover bg-center"
  style="background-image: url('/img/donate.jpg');">
  
  <div class="relative z-10 space-y-16">
    <p class="text-6xl font-semibold">
      Technology is changing the lives of millions of Pakistanis, and you can be a part of that change.
    </p>
    <p>
      <a
        class="btn btn-lg btn-warning"
        href="https://www.paypal.com/donate/?hosted_button_id=BMRTQ3FT2KPAL">
        Donate Now
      </a>
    </p>
  </div>
</section>
      </div>

    </div>
  </div>
</MainLayout>

