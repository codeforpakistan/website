---
import MainLayout from '../../layouts/MainLayout.astro';
import CardSection from '../../components/sections/CardSection.astro';
import CardGrid from '../../components/sections/CardGrid.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';

const programs = [
  {
    href: '/programs/services',
    title: 'Digital Solutions and Services',
    tagline:
      'Working with public sector organizations to design, prototype, and build better services',
    image: '/media/programs/program-services.jpg',
  },
  {
    href: '/programs/fellowships',
    title: 'Government Fellowships',
    tagline:
      'Connecting technology professionals with government to improve public services',
    image: '/media/programs/program-fellowships.jpg',
  },
  {
    href: '/programs/internships',
    title: 'Women Internships',
    tagline: 'Training and up-skilling women from under-represented communities',
    image: '/media/programs/program-internships.jpg',
  },
  {
    href: '/programs/innovator',
    title: 'Civic Innovator',
    tagline:
      'Engaging Youth to Improve Public Services and Driving Citizen-Centric Innovation',
    image: '/media/programs/program-innovator.jpg',
  },
  {
    href: '/programs/d4wee',
    title: 'Digitalization for Women\'s Economic Empowerment',
    tagline:
      'A modular curriculum building digital skills for economic independence',
    image: '/media/programs/d4wee.jpg',
  },
];
---

<MainLayout title="Programs">
  <div class="py-8">
    <div class="mb-6 space-y-2">
      <h1 class="text-3xl md:text-6xl tracking-tight">Programs</h1>
      <h2 class="text-lg md:text-3xl font-light text-gray-700">
        Helping communities work together to find new ways of solving old problems
      </h2>
    </div>
    <div class="max-w-5xl">
      <CardSection>
        <CardGrid>
          {programs.map((program) => (
            <ProjectCard
              href={program.href}
              image={program.image}
              title={program.title}
              tagline={program.tagline}
            />
          ))}
        </CardGrid>
      </CardSection>
    </div>
  </div>
</MainLayout>


