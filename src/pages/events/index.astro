---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import EventCard from '../../components/cards/EventCard.astro';
import CardGrid from '../../components/sections/CardGrid.astro';

const events = await getCollection('events');

function toTime(value?: string) {
  if (!value) return 0;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
}

const sortedEvents = [...events].sort((a, b) => {
  const startA = toTime(a.data.startDate);
  const startB = toTime(b.data.startDate);
  if (startA !== startB) return startB - startA;
  return a.data.title.localeCompare(b.data.title);
});
---

<MainLayout title="Events">
  <div class="py-8">
    <div class="mb-6 space-y-2">
      <h1 class="text-3xl md:text-6xl tracking-tight">Events</h1>
      <h2 class="text-lg md:text-3xl font-light text-gray-700">Join us for hackathons, workshops, and community gatherings.</h2>
    </div>
    <div class="max-w-5xl">
      {sortedEvents.length > 0 ? (
        <CardGrid>
          {sortedEvents.map((event) => (
            <EventCard
              href={`/events/${event.slug}`}
              image={event.data.image}
              title={event.data.title}
              location={event.data.location}
              date={event.data.startDate || event.data.endDate}
              summary={event.data.summary}
            />
          ))}
        </CardGrid>
      ) : (
        <div class="col-span-full text-center py-12">
          <p class="text-gray-500 text-lg">No events at this time.</p>
        </div>
      )}
    </div>
  </div>
</MainLayout>


