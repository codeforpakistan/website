---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import PeopleCard from '../../components/cards/PeopleCard.astro';
import CardGrid from '../../components/sections/CardGrid.astro';

const people = await getCollection('people');

const randomPeople = [...people];
for (let index = randomPeople.length - 1; index > 0; index -= 1) {
  const swapIndex = Math.floor(Math.random() * (index + 1));
  [randomPeople[index], randomPeople[swapIndex]] = [randomPeople[swapIndex], randomPeople[index]];
}

const featuredPeople = randomPeople.slice(0, 4);
---

<MainLayout title="About Us">
  <div class="py-8">
  <div class="mb-6 space-y-2">
    <h1 class="text-3xl md:text-6xl tracking-tight">About Us</h1>
    <h2 class="text-lg md:text-3xl font-light text-gray-700">Working to build a better, citizen-centered ecosystem of governance for everyone</h2>
  </div>
    <div class="flex flex-col md:flex-row gap-4 md:gap-8 lg:gap-12 xl:gap-16">
      <div class="flex-grow max-w-5xl">
        <article>
  <div class="w-full mb-8">
    <img src="/img/about_banner.jpg" alt="About Code for Pakistan" class="w-full h-auto rounded-lg">
  </div>
  <!-- About text and image side by side -->
  <div class="space-y-4">
    <p>
      Code for Pakistan is a civic innovation non-profit made up of a passionate community of technologists and
      talented professionals, driven by a strong belief in civic innovation and social impact that can move Pakistan
      forward in measurable and meaningful ways.
    </p>

    <p>
      We have spent the last decade partnering with the government and advising both the public and private sectors
      on designing technology around our communities in order to improve the quality of life and increase access to
      government services across Pakistan.
    </p>

    <p>
      Our vision is to have a government that meets people's needs where they are, and we leverage the power of
      technology and people to bridge the gap between government and citizens.
    </p>
  </div>

    <!-- Vision & Mission -->
    <section class="grid md:grid-cols-2 gap-8 py-4 lg:py-8">
      <div class="bg-cfp-blue-500 p-4 lg:p-12 lg:text-end rounded">
        <h3 class="text-lg md:text-xl lg:text-xl font-bold mb-4 text-white">Vision</h3>
        <p class="lg:text-3xl text-white font-light">
          A world where every citizen enjoys a seamless and dignified public life
        </p>
      </div>

      <div class="bg-cfp-green-500 p-4 lg:p-12 lg:text-start rounded">
        <h3 class="text-lg md:text-xl lg:text-xl font-bold mb-4 text-white">Mission</h3>
        <p class="lg:text-3xl text-white font-light">
          Harness the power of people and technology to improve the civic experience
        </p>
      </div>
    </section>

    <!-- Code for All Network -->
    <section class="mb-12">
      <h3 class="heading mb-4">Part of a Global Movement</h3>
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <img src="/img/cfa_map_1.png" alt="Code for All Global Network" class="w-full" />
        </div>
        <div class="space-y-4">
          <p>
            We are a member of the global
            <a href="https://codeforall.org/" class="link" target="_blank">Code for All</a>
            movement, an international network of organizations who believe that when used correctly, digital technology
            can improve governance and open new channels for citizens to engage more meaningfully in the public sphere
            and have a positive impact on their communities.
          </p>
          <p>
            Other Code for All members include the
            <a href="https://codeforamerica.org/" class="link" target="_blank">United States</a>
            ,
            <a href="https://www.codeforaustralia.org/" class="link" target="_blank">Australia</a>
            ,
            <a href="https://www.codefor.de/" class="link" target="_blank">Germany</a>
            ,
            <a href="https://mojepanstwo.pl/" class="link" target="_blank">Poland</a>
            ,
            <a href="https://codefor.nl/" class="link" target="_blank">the Netherlands</a>
            ,
            <a href="https://openup.org.za/" class="link" target="_blank">South Africa</a>
            ,
            <a href="https://codeforafrica.org/" class="link" target="_blank">Africa</a>
            ,
            <a href="https://www.slashroots.org/" class="link" target="_blank">the Caribbean</a>
            ,
            <a href="https://www.codeandomexico.org/" class="link" target="_blank">Mexico</a>
            ,
            <a href="https://www.code4japan.org/" class="link" target="_blank">Japan</a>
            , and
            <a href="https://codeforall.org/our-global-network" class="link" target="_blank">many more</a>
            .
          </p>
        </div>
      </div>
    </section>

    <!-- Our History -->
    <section class="mt-16">
      <h3 class="heading mb-4">
        Our History
      </h3>
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <img src="/img/history_2013.jpg" alt="Code for Pakistan History" class="w-full rounded" />
        </div>
        <div class="space-y-4">
          <p>
            Since 2013, Code for Pakistan has been at the forefront of civic innovation in Pakistan. From our first civic hackathon in Karachi to establishing a nationwide network of civic innovation labs, we've been working to bridge the gap between government and citizens through technology.
          </p>
          <p>
            Over the past decade, we've partnered with government departments, launched fellowship programs, and empowered thousands of citizens to engage with their communities in meaningful ways.
          </p>
          <a href="/about/history" class="inline-block px-6 py-3 bg-sky-500 text-white font-semibold rounded-full hover:bg-sky-600 transition-colors">
            Explore Our Journey
          </a>
        </div>
      </div>
    </section>

    <!-- Our Team -->
    <section class="mt-16">
      <h3 class="heading mb-4">
        <a href="/about/people">Our Team</a>
      </h3>

      {featuredPeople.length > 0 ? (
        <CardGrid gridClass="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8">
          {featuredPeople.map((person) => (
            <PeopleCard
              href={`/about/people/${person.slug}`}
              image={person.data.image}
              title={person.data.title}
              designation={person.data.designation}
            />
          ))}
        </CardGrid>
      ) : (
        <p class="text-gray-500">No team members to display.</p>
      )}
    </section>

    <!-- Call to Action -->
    <!-- include components/cta.html removed -->
</article>
      </div>

    </div>
  </div>
</MainLayout>


