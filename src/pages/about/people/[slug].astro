---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();

function normalizeUrl(url: string, base: string) {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  return `${base}${url.replace(/^\/+/, '')}`;
}

const linkedinUrl = normalizeUrl(person.data.linkedin, 'https://www.linkedin.com/in/');
const githubUrl = normalizeUrl(person.data.github, 'https://github.com/');
const twitterUrl = normalizeUrl(person.data.twitter, 'https://x.com/');
---

<MainLayout title={`${person.data.title}`}>
  <div class="py-8">
    <div class="mb-6 space-y-2">
      <h1 class="text-3xl md:text-6xl tracking-tight">{person.data.title}</h1>
      <h2 class="text-lg md:text-3xl font-light text-gray-700">{person.data.designation}</h2>
    </div>
    <div class="flex flex-col md:flex-row gap-4 md:gap-8 lg:gap-12 xl:gap-16">
      <div class="flex-grow max-w-5xl">
        <section>
          <div class="rich-text-content text-gray-700">
            <Content />
          </div>
        </section>
      </div>
      <div class="md:sticky md:top-24 md:self-start md:w-80 lg:w-96">
        <aside>
          <img src={person.data.image} alt={person.data.title} class="aspect-square rounded-lg" />
          {(linkedinUrl || githubUrl || twitterUrl) && (
            <div class="mt-4 rounded-lg border p-4">
              <h3 class="font-semibold text-gray-900 mb-2">Connect</h3>
              <div class="space-y-2 text-sm">
                {linkedinUrl && <a class="text-sky-700 hover:underline block" href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
                {githubUrl && <a class="text-sky-700 hover:underline block" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>}
                {twitterUrl && <a class="text-sky-700 hover:underline block" href={twitterUrl} target="_blank" rel="noopener noreferrer">Twitter/X</a>}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </div>
</MainLayout>


