---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact Us">
  <div class="py-8">
  <div class="mb-6 space-y-2">
    <h1 class="text-3xl md:text-6xl tracking-tight">Contact Us</h1>
    <h2 class="text-lg md:text-3xl font-light text-gray-700">Get in touch with the Code for Pakistan team</h2>
  </div>
    <div class="flex flex-col md:flex-row gap-4 md:gap-8 lg:gap-12 xl:gap-16">
      <div class="flex-grow max-w-5xl">
        <div class="flex gap-8">
  <div class="col-span-2">
    <p>
      <iframe
        style="border-width: 0"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2790.3405768869375!2d73.08597064284196!3d33.72723872876086!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df959dbd07b4af%3A0x6ee7fb4bc6f05fdb!2sCode%20for%20Pakistan!5e0!3m2!1sen!2s!4v1713958588005!5m2!1sen!2s"
        width="600"
        height="450"
        allowfullscreen="
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </p>
  </div>
  <div class="space-y-2">
    <h5>Share your ideas</h5>
    <p>
      If you are interested in learning more, you can always send us an email. We would love to hear from you!&nbsp;
    </p>
    <p>
      <a class="btn btn-sm btn-primary" href="tel:+92516162001">Drop us a line</a>
    </p>
    <p>
      <a class="btn btn-sm btn-secondary" href="mailto:info@codeforpakistan.org">Send us an email</a>
    </p>
  </div>
</div>
      </div>

    </div>
  </div>
</MainLayout>

